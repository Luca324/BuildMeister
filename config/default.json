{
  "shop": {
    "name": "BuildMeister",
    "currency": "NOK",
    "language": "nb",
    "weightUnit": "kg",
    "country": "NO",
    "homeUrl": "https://buildmeister.no"
  },
  "catalog": {
    "product": {
      "image": {
        "thumbnail": {
          "width": 120,
          "height": 120
        },
        "listing": {
          "width": 300,
          "height": 300
        },
        "single": {
          "width": 600,
          "height": 600
        }
      }
    },
    "showOutOfStockProduct": true,
    "categories": {
      "computers": {
        "name": "Datamaskiner",
        "layout": "grid"
      },
      "components": {
        "name": "Datakomponenter",
        "layout": "grid"
      },
      "accessories": {
        "name": "Tilbehør",
        "layout": "list"
      },
      "peripherals": {
        "name": "Periferiutstyr",
        "layout": "grid"
      },
      "networking": {
        "name": "Nettverk",
        "layout": "grid"
      }
    }
  },
  "system": {
    "theme": "tech",
    "file_storage": "s3",
    "extensions": [
      {
        "name": "categories_widget",
        "resolve": "extensions/categories_widget",
        "enabled": true,
        "priority": 20
      },
      {
        "name": "order_status_display",
        "resolve": "extensions/order_status_display",
        "enabled": true,
        "priority": 15
      },
      {
        "name": "s3_file_storage",
        "resolve": "node_modules/@evershop/s3_file_storage",
        "enabled": true,
        "priority": 10
      },
      {
        "name": "google_login",
        "resolve": "node_modules/@evershop/google_login",
        "enabled": true,
        "priority": 13
      },
      {
        "name": "shipping-api",
        "resolve": "extensions/shipping-api",
        "enabled": true,
        "priority": 25
      }
    ]
  },
  "pricing": {
    "rounding": "round",
    "precision": 0,
    "tax": {
      "rounding": "round",
      "precision": 0,
      "round_level": "unit",
      "price_including_tax": true
    }
  },
  "copyRight": "© 2025 BuildMeister. Alle rettigheter reservert.",
  "themeConfig": {
    "logo": {
      "alt": "BuildMeister",
      "src": "/logo.png",
      "width": 180,
      "height": 180
    },
    "copyRight": "© 2025 BuildMeister. Alle rettigheter reservert.",
    "headTags": {
      "links": [
        {
          "rel": "icon",
          "href": "/favicon.ico"
        },
        {
          "rel": "image",
          "href": "/logo.png" 
        },
        {
          "rel": "script",
          "href": "/custom.js" 
        }
      ],
      "metas": [
        {
          "name": "description",
          "content": "BuildMeister - Din pålitelige leverandør av datamaskiner, komponenter og elektronikktilbehør. Fri frakt over 1000 kr!"
        },
        {
          "name": "keywords",
          "content": "datamaskiner, bærbare PC-er, komponenter, tilbehør, Norge, elektronikk"
        }
      ]
    }
  },
  "customer": {
    "addressSchema": {
      "type": "object",
      "properties": {
        "full_name": {
          "type": "string"
        },
        "telephone": {
          "type": ["string", "number"]
        },
        "address_1": {
          "type": "string"
        },
        "address_2": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "province": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "postcode": {
          "type": ["string", "number"]
        }
      },
      "required": [
        "full_name",
        "telephone",
        "address_1",
        "city",
        "country",
        "province",
        "postcode"
      ],
      "errorMessage": {
        "properties": {
          "full_name": "Fullt navn er påkrevd",
          "telephone": "Telefonnummer mangler eller er ugyldig",
          "address_1": "Adresse mangler eller er ugyldig",
          "province": "Fylke mangler eller er ugyldig",
          "postcode": "Postnummer mangler eller er ugyldig",
          "country": "Land mangler eller er ugyldig"
        }
      },
      "additionalProperties": true
    }
  },
  "oms": {
    "order": {
      "status": {
        "new": { 
          "name": "Ny",
          "badge": "default", 
          "progress": "incomplete", 
          "isDefault": true,
          "next": [ 
            "processing",
            "canceled"
          ]
        },
        "processing": {
          "name": "Behandles",
          "badge": "default",
          "progress": "incomplete",
          "next": [
            "completed",
            "canceled"
          ]
        },
        "completed": {
          "name": "Fullført",
          "badge": "success",
          "progress": "complete",
          "next": [
            "closed"
          ]
        },
        "canceled": {
          "name": "Avbrutt",
          "badge": "critical",
          "progress": "complete",
          "next": []
        },
        "closed": {
          "name": "Lukket",
          "badge": "default",
          "progress": "complete",
          "next": []
        }
      },
      "shipmentStatus": {
        "pending": {
          "name": "Ventende",
          "badge": "default",
          "progress": "incomplete",
          "isDefault": true 
        },
        "processing": {
          "name": "Behandles",
          "badge": "default",
          "progress": "incomplete",
          "isDefault": false
        },
        "shipped": {
          "name": "Sendt",
          "badge": "attention",
          "progress": "complete"
        },
        "delivered": {
          "name": "Levert",
          "badge": "success",
          "progress": "complete",
          "isCancelable": false
        },
        "canceled": {
          "name": "Avbrutt",
          "badge": "critical",
          "progress": "complete",
          "isCancelable": false
        }
      },
      "paymentStatus": {
        "pending": {
          "name": "Ventende",
          "badge": "default",
          "progress": "incomplete",
          "isDefault": true 
        },
        "processing": {
          "name": "Behandles",
          "badge": "default",
          "progress": "incomplete",
          "isCancelable": false,
          "isDefault": false
        },
        "paid": {
          "name": "Betalt",
          "badge": "success",
          "progress": "complete"
        },
        "canceled": {
          "name": "Avbrutt",
          "badge": "critical",
          "progress": "complete",
          "isCancelable": false
        }
      }
    },
    "carriers": {
      "Postnord": {
        "name": "Postnord",
        "trackingUrl": "https://my.postnord.no/tracking/{trackingNumber}"
      },
      "Helthjem": {
        "name": "Helthjem",
        "trackingUrl": "https://www.helthjem.no/sporing/{trackingNumber}"
      },
      "Bring": {
        "name": "Bring",
        "trackingUrl": "https://sporing.bring.no/sporing/{trackingNumber}"
      }
    }
  }
}
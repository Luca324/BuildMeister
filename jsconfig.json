{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "node",
    "target": "ES2020",
    "checkJs": true,
    "jsx": "react",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "allowJs": true
  },
  "include": [
    "scripts/**/*.js",
    "themes/**/*.js",
    "themes/**/*.jsx",
    "extensions/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".evershop"
  ]
}

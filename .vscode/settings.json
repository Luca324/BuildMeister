{
  // Включаем ESLint для всех JS файлов
  "eslint.enable": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact"
  ],
  
  // Проверка при вводе и сохранении
  "eslint.run": "onType",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  
  // Включаем проблемы в реальном времени
  "problems.showCurrentInStatus": true,
  
  // ОТКЛЮЧАЕМ встроенную проверку JavaScript - используем ESLint вместо неё
  "javascript.validate.enable": false,
  "javascript.suggest.autoImports": true,
  "typescript.suggest.autoImports": true,
  
  // Подсветка неиспользуемых переменных
  "javascript.showUnused": true,
  "typescript.showUnused": true,
  
  // Включаем TypeScript проверку для JS файлов через jsconfig.json
  "javascript.implicitProjectConfig.checkJs": true,
  
  // Настройки для работы с ES модулями
  "javascript.preferences.useAliasesForRenames": false,
  
  // Включаем TypeScript language service для лучшей диагностики
  "typescript.validate.enable": true,
  "javascript.preferences.suggest.enabled": true
}
